# .gitignore

```gitignore id="jlwm9t"
# Virtual Environment
venv/
env/
ENV/

# Python Cache
__pycache__/
*.pyc
*.pyo
*.pyd

# VS Code
.vscode/

# PyCharm
.idea/

# Jupyter Notebook
.ipynb_checkpoints/

# Environment Variables
.env

# Build Files
build/
dist/
*.egg-info/

# OS Files
.DS_Store
Thumbs.db

# Test DICOM Files
test_dicoms/

# Logs
*.log

# Temporary Files
*.tmp
```
